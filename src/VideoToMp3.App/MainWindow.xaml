<Window x:Class="VideoToMp3.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:VideoToMp3.App.Converters"
        mc:Ignorable="d"
        Title="Video To MP3"
        Width="1220"
        Height="800"
        MinWidth="940"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop"
        Background="{DynamicResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.InputBindings>
        <KeyBinding Key="Enter" Modifiers="Control" Command="{Binding AddInputsCommand}" />
        <KeyBinding Key="F5" Command="{Binding StartAllCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelAllCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:FailedJobConverter x:Key="FailedJobConverter" />

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,9" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="Bold">
                    <Run Text="VIDEO" />
                    <Run Text=" → " Foreground="{DynamicResource PrimaryBrush}" />
                    <Run Text="MP3" />
                </TextBlock>
                <TextBlock Margin="0,5,0,0"
                           Foreground="{DynamicResource MutedTextBrush}"
                           Text="Chọn nhiều video hoặc dán nhiều link, mỗi đường dẫn nằm trên một dòng" />
            </StackPanel>
            <Border Grid.Column="1" Padding="12,6" VerticalAlignment="Center"
                    Background="{DynamicResource StatusBrush}" CornerRadius="16">
                <TextBlock Foreground="{DynamicResource PrimaryBrush}"
                           FontWeight="SemiBold" Text="{Binding DependencyStatus}" />
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="1.25*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Nguồn video" />
                    <TextBox Height="104" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                             Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Dán URL hoặc đường dẫn file, mỗi nguồn trên một dòng" />
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButtonStyle}"
                                Command="{Binding ChooseFilesCommand}"
                                Content="Chọn nhiều file..." />
                        <Button Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding AddInputsCommand}"
                                Content="Thêm vào hàng đợi" />
                    </StackPanel>
                    <TextBlock Margin="2,8,0,0"
                               Foreground="{DynamicResource ErrorBrush}"
                               TextWrapping="Wrap"
                               Text="{Binding InputValidationMessage}"
                               Visibility="{Binding HasInputValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Thiết lập đầu ra" />

                    <StackPanel Grid.Row="1">
                        <TextBlock Margin="0,0,0,5" FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}" Text="Thư mục lưu" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox IsReadOnly="True" Text="{Binding OutputDirectory, Mode=OneWay}"
                                     ToolTip="{Binding OutputDirectory}" />
                            <Button Grid.Column="1" Margin="8,0,0,0"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Command="{Binding ChooseOutputDirectoryCommand}"
                                    Content="Chọn..." />
                        </Grid>
                        <TextBlock Margin="2,6,0,0"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   TextWrapping="Wrap"
                                   Text="{Binding OutputValidationMessage}"
                                   Visibility="{Binding HasOutputValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,5" FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}" Text="Chất lượng MP3" />
                            <ComboBox ItemsSource="{Binding BitrateOptions}"
                                      SelectedItem="{Binding SelectedBitrate}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Margin="0,0,0,5" FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}" Text="Giao diện" />
                            <ComboBox ItemsSource="{Binding ThemeOptions}"
                                      SelectedItem="{Binding SelectedTheme}"
                                      ToolTip="Theo hệ thống, sáng hoặc tối" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="1.1*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Margin="0,0,0,5" FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}">
                                <Run Text="Tác vụ song song" />
                                <Run Text="{Binding Concurrency, StringFormat={} · {0}}" />
                            </TextBlock>
                            <Slider Minimum="1" Maximum="4" TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding Concurrency}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <CheckBox IsChecked="{Binding UseChromeCookies}"
                                      Content="Dùng cookie trình duyệt cho link online"
                                      ToolTip="Bật khi YouTube, Facebook hoặc website khác yêu cầu đăng nhập." />
                            <ComboBox Margin="0,8,0,0"
                                      ItemsSource="{Binding CookieBrowserOptions}"
                                      SelectedItem="{Binding CookieBrowser}"
                                      ToolTip="Firefox được khuyến nghị trên Windows vì Chrome mới chặn giải mã cookie." />
                            <CheckBox Margin="0,10,0,0"
                                      IsChecked="{Binding EmbedThumbnail}"
                                      Content="Nhúng ảnh bìa cho nguồn online" />
                            <CheckBox Margin="0,10,0,0"
                                      IsChecked="{Binding NotificationsEnabled}"
                                      Content="Thông báo khi hoàn tất" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <TabControl Grid.Row="2">
        <TabItem Header="Hàng đợi">
        <Border Style="{StaticResource CardStyle}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="18,15,18,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="Hàng đợi chuyển đổi" />
                    <TextBlock Grid.Column="1" Foreground="{DynamicResource MutedTextBrush}"
                               Text="{Binding JobSummary}" />
                </Grid>

                <Grid Grid.Row="1">
                    <DataGrid x:Name="QueueGrid" ItemsSource="{Binding Jobs}" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              BorderThickness="0" IsReadOnly="True" RowHeight="52"
                              ColumnHeaderHeight="38">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="Nhấp chuột phải để xem thao tác" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status, Converter={StaticResource FailedJobConverter}}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ErrorRowBrush}" />
                                        <Setter Property="ToolTip" Value="{Binding ErrorMessage}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Thử lại" Command="{Binding PlacementTarget.DataContext.RetryJobCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Hủy" Command="{Binding PlacementTarget.DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Mở MP3" Command="{Binding PlacementTarget.DataContext.OpenOutputFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Mở thư mục" Command="{Binding PlacementTarget.DataContext.OpenOutputFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="Xem lỗi" Command="{Binding PlacementTarget.DataContext.ViewErrorCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="Xóa khỏi hàng đợi" Command="{Binding PlacementTarget.DataContext.RemoveJobCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="2*" Header="Tên" Binding="{Binding DisplayName}" />
                            <DataGridTextColumn Width="*" Header="Nguồn" Binding="{Binding SourceType}" />
                            <DataGridTemplateColumn Width="*" Header="Trạng thái">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,3" CornerRadius="10" HorizontalAlignment="Left"
                                                Background="{DynamicResource StatusBrush}">
                                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}"
                                                       Text="{Binding Status}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="*" Header="Tiến trình">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding Progress, StringFormat={}{0:0}%}">
                                            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding Progress}" />
                                            <TextBlock Margin="0,11,0,0" HorizontalAlignment="Center" FontSize="11"
                                                       Text="{Binding Progress, StringFormat={}{0:0}%}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="*" Header="Chất lượng"
                                                Binding="{Binding RequestedBitrate, StringFormat={}{0} kbps}" />
                            <DataGridTextColumn Width="1.5*" Header="Đầu ra"
                                                Binding="{Binding OutputFilePath}" />
                            <DataGridTemplateColumn Width="Auto" MinWidth="236" Header="Thao tác">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource ActionButtonStyle}" Content="↻" ToolTip="Thử lại"
                                                    Command="{Binding DataContext.RetryJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Margin="4,0,0,0" Style="{StaticResource ActionButtonStyle}" Content="×" ToolTip="Hủy job"
                                                    Command="{Binding DataContext.CancelJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Margin="4,0,0,0" Style="{StaticResource ActionButtonStyle}" Content="−" ToolTip="Xóa khỏi hàng đợi"
                                                    Command="{Binding DataContext.RemoveJobCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Margin="4,0,0,0" Style="{StaticResource ActionButtonStyle}" Content="♫" ToolTip="Mở MP3"
                                                    Command="{Binding DataContext.OpenOutputFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Margin="4,0,0,0" Style="{StaticResource ActionButtonStyle}" Content="▣" ToolTip="Mở thư mục"
                                                    Command="{Binding DataContext.OpenOutputFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Margin="4,0,0,0" Style="{StaticResource ActionButtonStyle}" Content="⧉" ToolTip="Sao chép nguồn"
                                                    Command="{Binding DataContext.CopySourceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Margin="4,0,0,0" Style="{StaticResource ActionButtonStyle}" Content="!" ToolTip="Xem lỗi"
                                                    Command="{Binding DataContext.ViewErrorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsQueueEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock HorizontalAlignment="Center" FontSize="32"
                                   Foreground="{DynamicResource MutedTextBrush}" Text="♫" />
                        <TextBlock Margin="0,8,0,0" FontWeight="SemiBold"
                                   Text="Hàng đợi đang trống" />
                        <TextBlock Margin="0,4,0,0" Foreground="{DynamicResource MutedTextBrush}"
                                   Text="Thêm file hoặc URL để bắt đầu" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        </TabItem>
        <TabItem Header="Lịch sử">
            <Border Style="{StaticResource CardStyle}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox ToolTip="Tìm theo tên, nguồn hoặc file đầu ra"
                                 Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Grid.Column="1" Margin="8,0,0,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Command="{Binding ClearHistoryCommand}" Content="Xóa lịch sử" />
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding FilteredHistory}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" CanUserDeleteRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="2*" Header="Tên" Binding="{Binding DisplayName}" />
                            <DataGridTextColumn Width="*" Header="Trạng thái" Binding="{Binding Status}" />
                            <DataGridTextColumn Width="1.4*" Header="Hoàn tất" Binding="{Binding CompletedAt, StringFormat={}{0:g}}" />
                            <DataGridTextColumn Width="2*" Header="Đầu ra" Binding="{Binding OutputFilePath}" />
                            <DataGridTemplateColumn Width="Auto" Header="Thao tác">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource ActionButtonStyle}" Content="♫" ToolTip="Mở MP3"
                                                    Command="{Binding DataContext.OpenHistoryFileCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Margin="4,0,0,0" Style="{StaticResource ActionButtonStyle}" Content="▣" ToolTip="Mở thư mục"
                                                    Command="{Binding DataContext.OpenHistoryFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Margin="4,0,0,0" Style="{StaticResource ActionButtonStyle}" Content="+" ToolTip="Thêm lại vào hàng đợi"
                                                    Command="{Binding DataContext.ReAddHistoryCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </TabItem>
        </TabControl>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding StartAllCommand}"
                        ToolTip="Bắt đầu hàng đợi (F5)"
                        Content="CHUYỂN ĐỔI TẤT CẢ" />
                <Button Margin="10,0,0,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding CancelAllCommand}"
                        ToolTip="Hủy hàng đợi đang chạy (Esc)"
                        Content="Hủy" />
                <Button Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ClearCompletedCommand}"
                        Content="Xóa đã hoàn thành" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="28,1" VerticalAlignment="Center">
                <Grid Margin="0,0,0,5">
                    <TextBlock Foreground="{DynamicResource MutedTextBrush}" Text="{Binding OverallStatus}" />
                    <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold"
                               Text="{Binding OverallProgressText}" />
                </Grid>
                <ProgressBar Height="9" Minimum="0" Maximum="100"
                             ToolTip="{Binding OverallProgressText}"
                             Value="{Binding OverallProgress, Mode=OneWay}" />
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding OpenOutputDirectoryCommand}"
                    Content="Mở thư mục" />
        </Grid>
    </Grid>
</Window>
